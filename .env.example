# ── Brand ───────────────────────────────────────────────
BRAND_NAME="Kabar Kilat"
BRAND_HANDLE="@kabarkilat.id"
# Public URL of this app (used for links in Telegram + TikTok pull URLs)
APP_URL="https://your-app.vercel.app"

# ── Security ────────────────────────────────────────────
# Password for the dashboard login
ADMIN_PASSWORD="change-me"
# Random 32+ char string; signs the login cookie and Telegram buttons
SESSION_SECRET="generate-with-openssl-rand-hex-32"
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on cron calls
CRON_SECRET="another-random-string"

# ── Supabase ────────────────────────────────────────────
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# Public bucket for rendered cards/videos (platform APIs fetch media by URL)
SUPABASE_MEDIA_BUCKET="media"

# ── AI writer ───────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ── Pipeline tuning ─────────────────────────────────────
# A story needs this many independent outlets before a draft is written
MIN_SOURCES=2
# Politics is held to a stricter bar
MIN_SOURCES_POLITICS=3
# Max new drafts per generate run (controls AI cost)
MAX_DRAFTS_PER_RUN=4
# Posting slots in WIB (Asia/Jakarta), comma-separated HH:MM
POST_SLOTS="07:00,11:30,16:00,19:30,21:00"

# ── Telegram one-tap approval ───────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_OWNER_CHAT_ID=""
# Any random string; set as secret_token when calling setWebhook
TELEGRAM_WEBHOOK_SECRET=""

# ── Instagram (Graph API, Business/Creator account) ─────
IG_USER_ID=""
IG_ACCESS_TOKEN=""

# ── Threads ─────────────────────────────────────────────
THREADS_USER_ID=""
THREADS_ACCESS_TOKEN=""

# ── YouTube Shorts (Data API v3, OAuth) ─────────────────
YT_CLIENT_ID=""
YT_CLIENT_SECRET=""
YT_REFRESH_TOKEN=""

# ── TikTok (Content Posting API) ────────────────────────
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_ACCESS_TOKEN=""
TIKTOK_REFRESH_TOKEN=""
# Until your app passes TikTok's audit, posts are forced private.
# Set to "true" after the audit is approved.
TIKTOK_AUDITED="false"

# ── Video worker (GitHub Actions) ───────────────────────
# Fine-grained PAT with "Actions: write" on this repo, used to wake the worker
GITHUB_DISPATCH_TOKEN=""
GITHUB_REPO="youruser/kabar-agency"
# Optional Indonesian voiceover via Google Cloud Text-to-Speech
GOOGLE_TTS_API_KEY=""
GOOGLE_TTS_VOICE="id-ID-Wavenet-D"
