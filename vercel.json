{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/refresh-tokens",
      "schedule": "41 19 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/[job]/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/drafts/[id]/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/stories/[id]/draft/route.ts": {
      "maxDuration": 180
    }
  }
}